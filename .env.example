# =====================================================
#  AI Emply — Environment Configuration
# =====================================================

# 1. OpenAI LLM Configuration (Step 4 Demo Chat)
# Set your OpenAI API key here to enable cloud AI responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 2. Ollama LLM Configuration (Local Alternative)
# If OPENAI_API_KEY is not set, AI Emply will try local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 3. Database Configuration (PostgreSQL)
# Optional: If not set, automatically falls back to local JSON storage in .data/
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_emply
